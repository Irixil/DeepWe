    { "id": "pause-01", "message": "先别问了，我现在不想继续聊", "expected": { "intent": "pause", "emotion": "unclear", "adviceRequested": false, "needsDeepReasoning": false, "topics": [] } },
    { "id": "pause-02", "message": "让我静一会儿，今天先停在这里", "expected": { "intent": "pause", "emotion": "unclear", "adviceRequested": false, "needsDeepReasoning": false, "topics": [] } },
