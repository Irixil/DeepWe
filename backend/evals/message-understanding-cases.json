    { "id": "not-pause-01", "message": "算了……反正说什么他都不会懂", "expected": { "intent": "unclear", "emotion": "sadness", "adviceRequested": false, "needsDeepReasoning": true, "topics": ["invalidation"] } },
    { "id": "not-pause-02", "message": "我哭得说不清楚，但你别走，我还想说", "expected": { "intent": "continue_story", "emotion": "sadness", "adviceRequested": false, "needsDeepReasoning": true, "topics": [] } },
