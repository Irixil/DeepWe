{
  "version": 2,
  "description": "DeepWe 轻量语义模型人工合成评测集。真实模型评测时比较意图、情绪、复杂度和场景标签，不包含真实用户聊天。",
  "cases": [
    { "id": "continue-01", "message": "我还没说完，后来他又给我发了几条消息", "expected": { "intent": "continue_story", "emotion": "unclear", "adviceRequested": false, "needsDeepReasoning": false, "topics": [] } },
    { "id": "continue-02", "message": "呜呜……我脑子很乱，但我还想接着说", "expected": { "intent": "continue_story", "emotion": "sadness", "adviceRequested": false, "needsDeepReasoning": true, "topics": [] } },
    { "id": "continue-03", "message": "事情不是一句两句说得清，我先从昨天晚上讲", "expected": { "intent": "continue_story", "emotion": "unclear", "adviceRequested": false, "needsDeepReasoning": false, "topics": [] } },
    { "id": "continue-04", "message": "你先听我说，暂时不要给我建议", "expected": { "intent": "continue_story", "emotion": "unclear", "adviceRequested": false, "needsDeepReasoning": false, "topics": [] } },
    { "id": "correct-01", "message": "你理解错了，我难过的不是他迟到，是他完全没有提前告诉我", "expected": { "intent": "correct_ai", "emotion": "sadness", "adviceRequested": false, "needsDeepReasoning": true, "topics": ["ai_misunderstanding", "expectation"] } },
    { "id": "correct-02", "message": "不是这个意思，我没有想分手，我只是还不想马上原谅", "expected": { "intent": "correct_ai", "emotion": "mixed", "adviceRequested": false, "needsDeepReasoning": true, "topics": ["ai_misunderstanding", "not_ready_to_repair"] } },
    { "id": "correct-03", "message": "你刚才像是在替他说话，这没有接住我真正介意的部分", "expected": { "intent": "correct_ai", "emotion": "anger", "adviceRequested": false, "needsDeepReasoning": true, "topics": ["ai_misunderstanding"] } },
    { "id": "advice-01", "message": "我接下来到底应该怎么办，可以认真帮我分析一下吗", "expected": { "intent": "seek_advice", "emotion": "unclear", "adviceRequested": true, "needsDeepReasoning": true, "topics": [] } },
    { "id": "advice-02", "message": "我想跟他说清楚，又怕一开口就吵起来，我可以怎么表达", "expected": { "intent": "seek_advice", "emotion": "fear", "adviceRequested": true, "needsDeepReasoning": true, "topics": ["actionable_request"] } },
